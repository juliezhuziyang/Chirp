# Production: public URL of the Railway-hosted ML service (no trailing slash).
# When set, the frontend calls this URL directly instead of the local Vite proxy.
VITE_ML_SERVICE_URL=https://your-ml-service.up.railway.app

# Optional (local dev only): override the Vite dev proxy target when not using /api/ml.
# VITE_ML_DEV_PROXY=http://127.0.0.1:8000
